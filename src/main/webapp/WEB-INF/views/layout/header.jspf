<%@ page pageEncoding="UTF-8" %>
<%-- Plantilla comun: cabecera + menu de navegacion.
     Antes de incluirla, cada pagina define:
       tituloPagina  -> texto de la pestana del navegador
       moduloActivo  -> clientes | nuevo   (marca el enlace activo del menu)       --%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${tituloPagina}"/> | Gestión de Clientes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%-- Tema indigo + esmeralda: va despues de Bootstrap para poder sobrescribirlo.
         La letra es la del sistema (Segoe UI en Windows): no se descarga ninguna fuente.
         Si cambias estilos.css y no ves el cambio, sube el numero de "v" o recarga con Ctrl+F5. --%>
    <link href="${pageContext.request.contextPath}/css/estilos.css?v=2" rel="stylesheet">
</head>
<body>

<nav id="navPrincipal" class="navbar navbar-expand-md navbar-dark">
    <div class="container">
        <a id="navInicio" class="navbar-brand" href="${pageContext.request.contextPath}/ClienteServlet">
            <span class="marca-logo" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/>
                    <path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18.6 14.3A6.5 6.5 0 0 1 21.5 20"/>
                </svg>
            </span>
            Gestión de Clientes
        </a>
        <button id="btnMenu" class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#menuPrincipal" aria-controls="menuPrincipal"
                aria-expanded="false" aria-label="Mostrar menú">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div id="menuPrincipal" class="collapse navbar-collapse">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a id="navClientes" class="nav-link ${moduloActivo == 'clientes' ? 'active' : ''}"
                       href="${pageContext.request.contextPath}/ClienteServlet">Clientes</a>
                </li>
                <li class="nav-item">
                    <a id="navNuevoCliente" class="nav-link ${moduloActivo == 'nuevo' ? 'active' : ''}"
                       href="${pageContext.request.contextPath}/ClienteServlet?accion=nuevo">Registrar cliente</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="container contenido">
